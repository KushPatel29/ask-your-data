# Optional model-backed SQL path. Without this, the deterministic compiler runs.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the SQL model (default: claude-opus-5).
# ASK_YOUR_DATA_MODEL=claude-sonnet-5

# Optional free/local SQL model through any OpenAI-compatible endpoint such as
# Ollama, llama.cpp, vLLM, or LM Studio. Selecting a local provider activates
# the model path without requiring an Anthropic key. Configuration typos fail
# closed instead of silently falling back to a cloud provider.
# ASK_PROVIDER=ollama
# ASK_LOCAL_BASE_URL=http://localhost:11434
# ASK_LOCAL_MODEL=qwen2.5-coder:7b
# ASK_LOCAL_MODE=auto  # auto | tools | schema | prompt
# ASK_LOCAL_API_KEY=  # only when the local gateway requires one

# Local schema/exemplar embeddings. The model and extracted files are SHA-256
# pinned. Persisting the tiny exact matrices is optional and corpus-fingerprinted.
# ASK_EMBEDDING_CACHE_DIR=/var/cache/ask-your-data/models
# ASK_RETRIEVAL_PERSIST_DIR=/var/cache/ask-your-data/indexes

# Free self-hosted voice through Speaches (faster-whisper + Kokoro).
# ASK_VOICE_BASE_URL=http://localhost:8000/v1
# ASK_STT_MODEL=Systran/faster-whisper-small
# ASK_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# ASK_TTS_VOICE=af_heart
# In-process Piper default (male, CC0 source dataset; release checksum-pinned):
# ASK_LOCAL_TTS_VOICE=en_US-joe-medium

# Optional cloud voice fallback when ASK_VOICE_BASE_URL is unset.
# OPENAI_API_KEY=sk-...

# Durable audit JSONL. Leave unset for the bounded in-memory session demo.
# ASK_YOUR_DATA_AUDIT=/var/lib/ask-your-data/audit.jsonl

# Optional privacy-minimized n8n operations event sink.
# ASK_N8N_WEBHOOK_URL=http://localhost:5678/webhook/ask-your-data-events
# ASK_N8N_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Enterprise identity and application policy. Disabled is the honest synthetic
# public-demo mode. OIDC mode fails closed unless all settings and a bearer JWT
# are present; only RS256 tokens with issuer/audience/exp/iat/sub are accepted.
# ASK_AUTH_MODE=oidc
# ASK_OIDC_ISSUER=https://identity.example.com/
# ASK_OIDC_AUDIENCE=ask-your-data
# ASK_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# ASK_OIDC_ROLES_CLAIM=roles
# ASK_OIDC_TENANT_CLAIM=tenant_id
# ASK_AUTH_HEADER=Authorization
# ASK_POLICY_FILE=/run/secrets/ask-your-data-policy.yaml
# ASK_ACCESS_TOKEN=...  # CLI only; prefer a short-lived service/user token

# One monotonic deadline across model/retrieval/verification/query stages.
# ASK_REQUEST_TIMEOUT_S=45
