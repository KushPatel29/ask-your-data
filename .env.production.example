# Copy values into the deployment's secret manager, never commit real secrets.
# Selecting production refuses the anonymous defaults used by the public demo.
ASK_DEPLOYMENT_MODE=production
ASK_AUTH_MODE=oidc
ASK_OIDC_ISSUER=https://your-identity-provider.example/
ASK_OIDC_AUDIENCE=ask-your-data
ASK_OIDC_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
ASK_POLICY_FILE=/run/secrets/ask-your-data-policy.yaml
# Provision a protected, persistent mount and forward to your central audit sink.
# JSONL alone is not tamper-evident/WORM storage.
ASK_YOUR_DATA_AUDIT=/var/lib/ask-your-data/audit/events.jsonl
ASK_REQUEST_TIMEOUT_S=45
ASK_LOCAL_STT_MODEL=tiny.en
ASK_LOCAL_TTS_VOICE=en_US-joe-medium
ASK_VOICE_PREWARM=1
